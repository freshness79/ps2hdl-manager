// Windows resources: icon, manifest (administrator, DPI aware) and version
// information. Compiled into rsrc_windows_amd64.syso by `make windows`
// (windres from mingw-w64); the committed .syso is used when windres is missing.
// VER_MAJOR, VER_MINOR, VER_PATCH and VER_STR come from the Makefile.

#ifndef VER_MAJOR
#define VER_MAJOR 1
#define VER_MINOR 1
#define VER_PATCH 0
#define VER_STR "1.1.0"
#endif

1 ICON "../../assets/icon/icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK   0x3f
FILEFLAGS       0
FILEOS          0x40004
FILETYPE        1
FILESUBTYPE     0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "freshness"
      VALUE "FileDescription",  "PS2 HDL Manager"
      VALUE "FileVersion",      VER_STR
      VALUE "InternalName",     "ps2hdl-manager"
      VALUE "LegalCopyright",   "Copyright (C) 2026 freshness. GPL-2.0-or-later"
      VALUE "OriginalFilename", "ps2hdl-manager.exe"
      VALUE "ProductName",      "PS2 HDL Manager"
      VALUE "ProductVersion",   VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
